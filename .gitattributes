# This repository is bytes, not text.
#
# The kit's verdicts are recorded against the SHA-256 of each artifact, so a
# checkout that rewrote a line ending would change a file's bytes and turn a
# recorded verdict into a false accusation. Nothing is translated: by default
# every file is stored and checked out exactly as it is.
* -text

# Source is read by people, so it is marked as text and pinned to LF: a Windows
# checkout and a Linux checkout produce the same bytes, and a diff is still a
# diff.
*.js         text eol=lf
*.md         text eol=lf
*.json       text eol=lf
.gitattributes text eol=lf
.gitignore   text eol=lf
LICENSE      text eol=lf
