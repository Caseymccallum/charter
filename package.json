{
  "name": "charter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": ".charter: a local-first document format with checkable edit history, and a verifier a stranger can run without trusting the author.",
  "license": "MIT",
  "bin": {
    "charter": "./cli/charter.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "test": "node --test",
    "test:python": "cd implementations/python && python -m unittest discover",
    "kit:python": "cd implementations/python && python -m charter_verify.kit",
    "probe": "node vectors/probe/run.js",
    "probe:build": "cd implementations/python && python tools/probe.py --build",
    "probe:check": "cd implementations/python && python tools/probe.py --check",
    "corpus": "node vectors/container/run.js",
    "corpus:build": "cd implementations/python && python tools/corpus.py --build",
    "corpus:check": "cd implementations/python && python tools/corpus.py --check",
    "sweep": "cd implementations/python && python tools/sweep.py",
    "sweep:all": "cd implementations/python && python tools/sweep.py --all",
    "editor": "node editor/serve.mjs",
    "editor:test": "node --test test/editor.test.js",
    "verify": "node cli/charter.js verify",
    "seal": "node cli/charter.js seal",
    "inspect": "node cli/charter.js inspect",
    "cite": "node cli/charter.js cite",
    "keygen": "node cli/charter.js keygen",
    "kit": "node vectors/run.js",
    "kit:build": "node vectors/build.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
