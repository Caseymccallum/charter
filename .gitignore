node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp
*.local

# The Python verifier's compiled bytecode. Not source, not the kit, and not
# recorded: a .pyc is a function of the interpreter that wrote it.
__pycache__/
*.pyc

# vectors/out/, vectors/probe/out/ and vectors/container/out/ are committed on
# purpose: the artifacts are the kit, the probe and the corpus, and each of the
# three records its answers against a digest of the bytes. A record of files
# nobody has is not a record, so these are not ignored.
